      "display": "DeepSeek（官方 API）",
      "kind": "official",
      "protocol": "openai",
      "api_base": "https://api.deepseek.com",
      "chat_path": "/chat/completions",
      "auth_style": "bearer",
      "env_names": ["DEEPSEEK_API_KEY"],
      "key_ref_default": "brain-ai/deepseek",
      "capabilities": { "vision": false, "seed": true, "system_role": true, "stream": false },
      "models": [
        { "id": "deepseek-chat", "label": "deepseek-chat（通用）" },
        { "id": "deepseek-reasoner", "label": "deepseek-reasoner（推理）" }
