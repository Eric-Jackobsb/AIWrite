        { "id": "DBG-M4-04", "desc": "网页版请求忽略 temperature / max_tokens / top_p（网页前端无对应开关）", "doc": "docs/actionPlan/M_patchA.md · §4.1 PB-05" },
        { "id": "DBG-M4-05", "desc": "会话失效（40002/401）只呈现为通用错误串，缺少「重新登录」引导", "doc": "docs/actionPlan/M_patchA.md · §4.1 PB-07" }
      ],
      "M5": [
