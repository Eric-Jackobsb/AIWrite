    "exec_selftest": "72 通过 / 0 失败（执行器 + 运行信息 + 归档）",
    "run_selftest": "PASS（离线 3/5，失败 1 为预期）",
    "run_selftest_web": "PASS（5/5，约 6–9 s，含 PC-05 归档断言）",
